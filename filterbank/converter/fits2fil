#!/bin/zsh

set -euo pipefail

# This script lives in filterbank/converter; the importable package is
# "converter", so its parent directory (filterbank/) goes on PYTHONPATH.
SCRIPT_DIR=${0:A:h}
PACKAGE_PARENT=${SCRIPT_DIR:h}
export PYTHONPATH="${PACKAGE_PARENT}${PYTHONPATH:+:${PYTHONPATH}}"

if command -v python3.13 >/dev/null 2>&1; then
  exec python3.13 -m converter "$@"
fi

exec python3 -m converter "$@"
