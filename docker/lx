#!/bin/bash
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" = /* ]] || src="$d/$src"
done
here="$(cd "$(dirname "$src")" && pwd)"
conf="$here/systems.conf"

die() { echo "lx: $*" >&2; exit 1; }

usage() {
  cat <<'U'
lx list                      systems and whether they are installed
lx start | stop | status     Linux engine on / off / state
lx shell NAME                interactive shell, current folder at /work
lx run NAME CMD [ARG...]     one command, current folder at /work
lx build NAME                rebuild from images/NAME/Dockerfile
lx old                       stopped containers and how much they changed
lx resume CONTAINER          reopen a stopped container with its old changes
lx where                     where images and engine data live on disk
options before NAME: --net-off   no network     -v HOST:GUEST   extra folder
U
}

up() { docker info >/dev/null 2>&1; }

start() {
  up && return 0
  echo "lx: starting the Linux engine" >&2
  if [ "$(uname)" = Darwin ]; then
    if command -v colima >/dev/null && docker context inspect colima >/dev/null 2>&1; then
      colima start >&2
    else
      open -gj -a Docker
    fi
  else
    sudo systemctl start docker
  fi
  for _ in $(seq 1 90); do up && return 0; sleep 1; done
  die "engine did not come up in 90 s"
}

lookup() {
  local line
  line="$(awk -F'|' -v n="$1" '$1==n' "$conf")"
  [ -n "$line" ] || die "unknown system '$1'; see: lx list"
  IFS='|' read -r name image platform desc <<<"$line"
}

opts=()
parse_opts() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --net-off) opts+=(--network none); shift ;;
      -v) [ $# -ge 2 ] || die "-v needs HOST:GUEST"; opts+=(-v "$2"); shift 2 ;;
      *) break ;;
    esac
  done
  rest=("$@")
}

enter() {
  local mode="$1"; shift
  parse_opts "$@"
  [ ${#rest[@]} -ge 1 ] || die "which system? see: lx list"
  lookup "${rest[0]}"
  start
  docker image inspect "$image" >/dev/null 2>&1 || die "$image is not installed; try: lx build $name"
  local base=(docker run --rm --pull never -v "$PWD:/work" -w /work)
  [ "$platform" = auto ] || base+=(--platform "$platform")
  [ ${#opts[@]} -eq 0 ] || base+=("${opts[@]}")
  if [ "$mode" = shell ]; then
    exec "${base[@]}" -it --entrypoint sh "$image" -c 'command -v bash >/dev/null && exec bash; exec sh'
  fi
  [ ${#rest[@]} -ge 2 ] || die "no command given"
  base+=(-i)
  if [ -t 0 ] && [ -t 1 ]; then base+=(-t); fi
  exec "${base[@]}" --entrypoint "${rest[1]}" "$image" "${rest[@]:2}"
}

cmd="${1:-help}"
[ $# -eq 0 ] || shift
case "$cmd" in
  list)
    up && on=1 || on=0
    while IFS='|' read -r name image platform desc; do
      [ -n "$name" ] || continue
      if [ $on = 0 ]; then s="engine off"
      elif docker image inspect "$image" >/dev/null 2>&1; then s="installed"
      else s="missing"; fi
      printf '%-12s %-11s %-12s %s\n' "$name" "$s" "$platform" "$desc"
    done <"$conf" ;;
  start) start; echo "engine on" ;;
  stop)
    if command -v colima >/dev/null && colima status >/dev/null 2>&1; then colima stop
    elif [ "$(uname)" = Darwin ]; then docker desktop stop
    else sudo systemctl stop docker; fi ;;
  status) if up; then echo "engine on"; docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'; else echo "engine off"; fi ;;
  shell) enter shell "$@" ;;
  run) enter run "$@" ;;
  build)
    [ $# -eq 1 ] || die "usage: lx build NAME"
    lookup "$1"
    dir="$here/images/${image%%:*}"
    [ -f "$dir/Dockerfile" ] || die "no recipe at $dir/Dockerfile"
    start
    docker build --platform "$platform" -t "$image" "$dir" ;;
  old) start; docker ps -as --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Size}}' ;;
  resume) [ $# -eq 1 ] || die "usage: lx resume CONTAINER"; start; exec docker start -ai "$1" ;;
  where)
    start
    docker context show
    docker images
    docker system df
    raw="$HOME/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw"
    if [ -e "$raw" ]; then du -sh "$raw"; fi ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
